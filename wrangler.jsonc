{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "futball-tkf",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tkf",
      "database_id": "local-placeholder",
      "migrations_dir": "migrations"
    }
  ]
}
